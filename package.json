{
  "name": "pocket-basketball",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "check": "tsc && vitest run --tagsFilter '!slow'",
    "sim": "node src/tools/simulate.ts",
    "watch-match": "node src/tools/watch.ts",
    "dev": "vite",
    "build": "vite build",
    "browser-check": "node src/tools/browser-check.ts",
    "anim-check": "node src/tools/anim-check.ts",
    "sound-wavs": "node src/tools/sound-wavs.ts",
    "review": "node src/tools/review.ts",
    "gpu-check": "node src/tools/gpu-check.ts",
    "sequences": "node src/tools/sequences.ts",
    "build-page": "node src/tools/build-page.ts",
    "build-mock": "node src/tools/build-mock.ts",
    "build-icon": "node src/tools/build-icon.ts",
    "balance": "vitest run --tagsFilter slow",
    "check-all": "tsc && vitest run"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
