{
  "name": "pocket-basketball",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "check": "tsc && tsc -p tsconfig.web.json --noEmit && vitest run",
    "sim": "node src/tools/simulate.ts",
    "watch-match": "node src/tools/watch.ts",
    "build": "tsc -p tsconfig.web.json && node -e \"const fs=require('node:fs');fs.copyFileSync('src/web/index.html','dist/index.html');fs.copyFileSync('docs/03-estudo-visual.html','dist/03-estudo-visual.html')\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
